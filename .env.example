DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Only needed when DJANGO_DEBUG=False (production) -- comma-separated, include scheme:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- Local development database (ignored if DATABASE_URL is set below) ---
USE_MYSQL=True
DB_NAME=smartwater_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Render / any Postgres-via-URL deploy ---
# Render sets this automatically when you attach a Postgres database
# (see render.yaml) -- don't set it locally unless you're pointing at a
# real Postgres instance. When present, this overrides USE_MYSQL entirely.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
